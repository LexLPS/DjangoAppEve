{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "celery -A eve beat -l INFO",
    "preDeployCommand": "python manage.py release_preflight --schema-only",
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 10,
    "drainingSeconds": 30
  }
}
