# Copy this file to .env. Never commit the resulting .env file.

# Runtime: dev, staging, or prod
DJANGO_ENV=dev
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080

# PostgreSQL
DB_NAME=eve_db
DB_USER=eve_user
DB_PASSWORD=replace-with-a-local-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=eve
MONGODB_MAX_POOL_SIZE=50

# Redis (optional in development, required in staging/production)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Use a dedicated persistent Redis service in staging/production. Reusing the
# cache Redis is acceptable only for local development.
CELERY_BROKER_URL=redis://localhost:6380/0

# Saleor. Create your own Saleor Cloud environment and channel.
SALEOR_GRAPHQL_URL=https://your-saleor-environment.saleor.cloud/graphql/
SALEOR_CHANNEL=default-channel
SALEOR_API_TOKEN=
SALEOR_JWKS_URL=https://your-saleor-environment.saleor.cloud/.well-known/jwks.json
SALEOR_JWKS_CACHE_SECONDS=3600

# Keep disabled until the live Saleor integration tests and webhook round-trip pass.
CHECKOUT_ENABLED=False
PRODUCT_CACHE_TTL_SECONDS=3600

# Development email is printed to the terminal. Production overrides this with SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
PUBLIC_BASE_URL=http://localhost:8000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Admin and proxy security
DJANGO_ADMIN_URL=admin/
DJANGO_ADMIN_REQUIRE_MFA=False
DJANGO_ADMIN_ALLOWED_IPS=
DJANGO_TRUSTED_PROXIES=
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# Logging, monitoring and retention
LOG_FORMAT=console
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
CONTACT_MESSAGE_RETENTION_DAYS=365
ABANDONED_CART_RETENTION_DAYS=365
WEBHOOK_EVENT_RETENTION_DAYS=90
